{{ 'purelane.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign fallback_collection = section.settings.fallback_collection
-%}

<section class="purelane-section purelane-bundles" id="bundles">
  <div class="purelane-wrap">
    <div class="purelane-glass purelane-bundles__intro purelane-rv">
      <div class="purelane-panel-head">
        {%- if section.settings.kicker != blank -%}
          <span class="purelane-kicker">{{ section.settings.kicker | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="purelane-title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="purelane-lede">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="purelane-bundles__tiers">
        {%- for block in section.blocks -%}
          {%- liquid
            assign quantity = block.settings.quantity | plus: 0
            assign bundle_product_1 = block.settings.product_1
            assign bundle_product_2 = block.settings.product_2
            assign bundle_product_3 = block.settings.product_3
            assign bundle_product_4 = block.settings.product_4
            assign bundle_product_5 = block.settings.product_5

            if fallback_collection != blank
              for fallback_product in fallback_collection.products
                if fallback_product.available
                  assign bundle_already_selected = false

                  if bundle_product_1 != blank and fallback_product.id == bundle_product_1.id
                    assign bundle_already_selected = true
                  endif

                  if bundle_product_2 != blank and fallback_product.id == bundle_product_2.id
                    assign bundle_already_selected = true
                  endif

                  if bundle_product_3 != blank and fallback_product.id == bundle_product_3.id
                    assign bundle_already_selected = true
                  endif

                  if bundle_product_4 != blank and fallback_product.id == bundle_product_4.id
                    assign bundle_already_selected = true
                  endif

                  if bundle_product_5 != blank and fallback_product.id == bundle_product_5.id
                    assign bundle_already_selected = true
                  endif

                  unless bundle_already_selected
                    if bundle_product_1 == blank
                      assign bundle_product_1 = fallback_product
                    elsif bundle_product_2 == blank
                      assign bundle_product_2 = fallback_product
                    elsif bundle_product_3 == blank
                      assign bundle_product_3 = fallback_product
                    elsif bundle_product_4 == blank
                      assign bundle_product_4 = fallback_product
                    elsif bundle_product_5 == blank
                      assign bundle_product_5 = fallback_product
                    endif
                  endunless
                endif

                if bundle_product_1 != blank and bundle_product_2 != blank and bundle_product_3 != blank and bundle_product_4 != blank and bundle_product_5 != blank
                  break
                endif
              endfor
            endif
          -%}
          <article class="purelane-glass purelane-tier{% if block.settings.featured %} purelane-tier--featured{% endif %} purelane-rv purelane-rv-d{{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
            {%- if block.settings.tier_name != blank -%}
              <span class="purelane-tier__tag">{{ block.settings.tier_name | escape }}</span>
            {%- endif -%}

            <div class="purelane-tier__products{% if quantity >= 5 %} purelane-tier__products--five{% endif %}" aria-hidden="true">
              {%- if quantity >= 1 or block.settings.product_1 != blank -%}
                <span class="purelane-tier__product">
                  {%- if bundle_product_1.featured_image -%}
                    <img src="{{ bundle_product_1.featured_image | image_url: width: 180 }}" alt="" width="{{ bundle_product_1.featured_image.width }}" height="{{ bundle_product_1.featured_image.height }}" loading="lazy">
                  {%- else -%}
                    <span class="purelane-mini-placeholder"></span>
                  {%- endif -%}
                </span>
              {%- endif -%}
              {%- if quantity >= 2 or block.settings.product_2 != blank -%}
                <span class="purelane-tier__product">
                  {%- if bundle_product_2.featured_image -%}
                    <img src="{{ bundle_product_2.featured_image | image_url: width: 180 }}" alt="" width="{{ bundle_product_2.featured_image.width }}" height="{{ bundle_product_2.featured_image.height }}" loading="lazy">
                  {%- else -%}
                    <span class="purelane-mini-placeholder"></span>
                  {%- endif -%}
                </span>
              {%- endif -%}
              {%- if quantity >= 3 or block.settings.product_3 != blank -%}
                <span class="purelane-tier__product">
                  {%- if bundle_product_3.featured_image -%}
                    <img src="{{ bundle_product_3.featured_image | image_url: width: 180 }}" alt="" width="{{ bundle_product_3.featured_image.width }}" height="{{ bundle_product_3.featured_image.height }}" loading="lazy">
                  {%- else -%}
                    <span class="purelane-mini-placeholder"></span>
                  {%- endif -%}
                </span>
              {%- endif -%}
              {%- if quantity >= 4 or block.settings.product_4 != blank -%}
                <span class="purelane-tier__product">
                  {%- if bundle_product_4.featured_image -%}
                    <img src="{{ bundle_product_4.featured_image | image_url: width: 180 }}" alt="" width="{{ bundle_product_4.featured_image.width }}" height="{{ bundle_product_4.featured_image.height }}" loading="lazy">
                  {%- else -%}
                    <span class="purelane-mini-placeholder"></span>
                  {%- endif -%}
                </span>
              {%- endif -%}
              {%- if quantity >= 5 or block.settings.product_5 != blank -%}
                <span class="purelane-tier__product">
                  {%- if bundle_product_5.featured_image -%}
                    <img src="{{ bundle_product_5.featured_image | image_url: width: 180 }}" alt="" width="{{ bundle_product_5.featured_image.width }}" height="{{ bundle_product_5.featured_image.height }}" loading="lazy">
                  {%- else -%}
                    <span class="purelane-mini-placeholder"></span>
                  {%- endif -%}
                </span>
              {%- endif -%}
            </div>

            <div class="purelane-tier__quantity">
              {{ quantity }}
              <small>{{ block.settings.quantity_label | escape }}</small>
            </div>

            <div class="purelane-tier__price">
              {{ block.settings.price_text | escape }}
              {%- if block.settings.compare_text != blank -%}
                <s>{{ block.settings.compare_text | escape }}</s>
              {%- endif -%}
            </div>

            {%- if block.settings.subtext != blank -%}
              <p class="purelane-tier__subtext">{{ block.settings.subtext | escape }}</p>
            {%- endif -%}

            {%- assign features = block.settings.features | newline_to_br | split: '<br />' -%}
            {%- if block.settings.features != blank -%}
              <ul class="purelane-tier__features">
                {%- for feature in features -%}
                  {%- assign clean_feature = feature | strip -%}
                  {%- if clean_feature != blank -%}
                    <li>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
                      <span>{{ clean_feature | escape }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- if block.settings.cta_label != blank -%}
              <a
                class="purelane-btn{% if block.settings.button_style == 'primary' %} purelane-btn--primary{% endif %}"
                {% if block.settings.cta_link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ block.settings.cta_link }}"
                {% endif %}
              >
                {{ block.settings.cta_label | escape }}
                {%- if block.settings.button_style == 'primary' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
                {%- endif -%}
              </a>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="purelane-glass purelane-shop__empty">{{ 'Add tier blocks to show bundle offers.' }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane bundle tiers",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Mix and match across kitchen, laundry, home and hands. One flat offer, free shipping, and no code needed."
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Fallback product collection",
      "info": "Used to fill empty product image slots in tier cards."
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Highlight tier",
          "default": false
        },
        {
          "type": "text",
          "id": "tier_name",
          "label": "Tier name",
          "default": "Starter"
        },
        {
          "type": "range",
          "id": "quantity",
          "label": "Quantity",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 2
        },
        {
          "type": "text",
          "id": "quantity_label",
          "label": "Quantity label",
          "default": "Products"
        },
        {
          "type": "text",
          "id": "price_text",
          "label": "Price text",
          "default": "Rs. 349"
        },
        {
          "type": "text",
          "id": "compare_text",
          "label": "Compare-at text",
          "default": "Rs. 598"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "Flat Rs. 174 per product"
        },
        {
          "type": "textarea",
          "id": "features",
          "label": "Features",
          "default": "Pick any two products\nFree shipping across India"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "CTA link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            {
              "value": "ghost",
              "label": "Glass"
            },
            {
              "value": "primary",
              "label": "Primary"
            }
          ],
          "default": "ghost"
        },
        {
          "type": "header",
          "content": "Product images"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "product",
          "id": "product_4",
          "label": "Product 4"
        },
        {
          "type": "product",
          "id": "product_5",
          "label": "Product 5"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane bundle tiers",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "tier_name": "Starter",
            "quantity": 2,
            "price_text": "Rs. 349",
            "compare_text": "Rs. 598",
            "subtext": "Flat Rs. 174 per product",
            "features": "Pick any two products\nFree shipping across India"
          }
        },
        {
          "type": "tier",
          "settings": {
            "featured": true,
            "tier_name": "Most popular",
            "quantity": 3,
            "price_text": "Rs. 499",
            "compare_text": "Rs. 897",
            "subtext": "Flat Rs. 166 per product",
            "features": "Pick any three products\nCovers kitchen and laundry\nFree shipping across India",
            "button_style": "primary"
          }
        },
        {
          "type": "tier",
          "settings": {
            "tier_name": "Whole home",
            "quantity": 5,
            "price_text": "Rs. 799",
            "compare_text": "Rs. 1495",
            "subtext": "Flat Rs. 160 per product",
            "features": "Pick any five products\nEvery room in one order\nFree shipping across India"
          }
        }
      ]
    }
  ]
}
{% endschema %}
