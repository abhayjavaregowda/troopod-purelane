{{ 'purelane.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane.js' | asset_url }}" defer="defer"></script>

<section class="purelane-section purelane-reviews" id="reviews">
  <div class="purelane-wrap">
    <div class="purelane-reviews__head purelane-rv">
      {%- if section.settings.kicker != blank -%}
        <span class="purelane-kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}

      {%- if section.settings.rating_text != blank -%}
        <span class="purelane-reviews__agg">
          <span class="purelane-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          {{ section.settings.rating_text | escape }}
        </span>
      {%- endif -%}

      {%- if section.settings.trust_text != blank -%}
        <span class="purelane-reviews__agg">{{ section.settings.trust_text | escape }}</span>
      {%- endif -%}
    </div>
  </div>

  <div class="purelane-reviews__rail purelane-rv" aria-label="{{ section.settings.rail_label | escape }}">
    <div class="purelane-reviews__track">
      {%- for block in section.blocks -%}
        <article class="purelane-glass-soft purelane-review-card" {{ block.shopify_attributes }}>
          <div class="purelane-review-card__stars" aria-label="{{ block.settings.stars }} out of 5 stars">
            {%- for i in (1..5) -%}
              {%- if i <= block.settings.stars -%}&#9733;{%- else -%}&#9734;{%- endif -%}
            {%- endfor -%}
          </div>

          {%- if block.settings.heading != blank -%}
            <h3 class="purelane-review-card__title">{{ block.settings.heading | escape }}</h3>
          {%- endif -%}

          {%- if block.settings.body != blank -%}
            <p class="purelane-review-card__body">{{ block.settings.body | escape }}</p>
          {%- endif -%}

          <div class="purelane-review-card__who">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
            <b>{{ block.settings.customer_name | escape }}</b>
            {%- if block.settings.product_label != blank -%}
              <span aria-hidden="true">&middot;</span>
              <span>{{ block.settings.product_label | escape }}</span>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}

      {%- for block in section.blocks -%}
        <article class="purelane-glass-soft purelane-review-card" aria-hidden="true" role="presentation">
          <div class="purelane-review-card__stars">
            {%- for i in (1..5) -%}
              {%- if i <= block.settings.stars -%}&#9733;{%- else -%}&#9734;{%- endif -%}
            {%- endfor -%}
          </div>

          {%- if block.settings.heading != blank -%}
            <h3 class="purelane-review-card__title">{{ block.settings.heading | escape }}</h3>
          {%- endif -%}

          {%- if block.settings.body != blank -%}
            <p class="purelane-review-card__body">{{ block.settings.body | escape }}</p>
          {%- endif -%}

          <div class="purelane-review-card__who">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
            <b>{{ block.settings.customer_name | escape }}</b>
            {%- if block.settings.product_label != blank -%}
              <span aria-hidden="true">&middot;</span>
              <span>{{ block.settings.product_label | escape }}</span>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane reviews",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Aggregate rating text",
      "default": "4.8 from 8,000+ reviews"
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Trust text",
      "default": "Loved by 12 lakh+ homes"
    },
    {
      "type": "text",
      "id": "rail_label",
      "label": "Rail accessibility label",
      "default": "Customer reviews"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Stars",
          "default": 5
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "customer_name",
          "label": "Customer name",
          "default": "Verified buyer"
        },
        {
          "type": "text",
          "id": "product_label",
          "label": "Product label",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "heading": "Works like a charm",
            "body": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.",
            "customer_name": "Anita",
            "product_label": "Laundry detergent"
          }
        },
        {
          "type": "review",
          "settings": {
            "heading": "Best dishwash ever",
            "body": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.",
            "customer_name": "Priya",
            "product_label": "Dishwash gel"
          }
        },
        {
          "type": "review",
          "settings": {
            "heading": "Great product, great packaging",
            "body": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.",
            "customer_name": "Sunita",
            "product_label": "Liquid handwash"
          }
        },
        {
          "type": "review",
          "settings": {
            "heading": "Sparkling taps again",
            "body": "Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.",
            "customer_name": "Verified buyer",
            "product_label": "Tap cleaner"
          }
        }
      ]
    }
  ]
}
{% endschema %}
