{{ 'purelane.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<section class="purelane-section purelane-shop" id="shop">
  <div class="purelane-wrap">
    <div class="purelane-panel-head purelane-rv">
      {%- if section.settings.kicker != blank -%}
        <span class="purelane-kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="purelane-title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <div class="purelane-rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      {%- if section.settings.description != blank -%}
        <p class="purelane-lede">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
      <div class="purelane-shop__grid" role="list">
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          {%- liquid
            assign variant = product.selected_or_first_available_variant
            assign price = variant.price
            assign compare_at_price = variant.compare_at_price
            assign is_available = variant.available
            assign product_form_id = 'purelane-product-form-' | append: section.id | append: '-' | append: product.id
          -%}
          <article class="purelane-glass purelane-card purelane-rv purelane-rv-d{{ forloop.index0 | modulo: 4 }}" role="listitem">
            <div class="purelane-card__media">
              {%- if product.available == false -%}
                <span class="purelane-card__pill">{{ 'products.product.sold_out' | t }}</span>
              {%- elsif compare_at_price > price -%}
                <span class="purelane-card__pill">{{ 'products.product.on_sale' | t }}</span>
              {%- elsif section.settings.default_badge != blank -%}
                <span class="purelane-card__pill">{{ section.settings.default_badge | escape }}</span>
              {%- endif -%}

              <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                {%- if product.featured_image -%}
                  <img
                    src="{{ product.featured_image | image_url: width: 420 }}"
                    srcset="
                      {%- if product.featured_image.width >= 180 -%}{{ product.featured_image | image_url: width: 180 }} 180w,{%- endif -%}
                      {%- if product.featured_image.width >= 320 -%}{{ product.featured_image | image_url: width: 320 }} 320w,{%- endif -%}
                      {%- if product.featured_image.width >= 420 -%}{{ product.featured_image | image_url: width: 420 }} 420w,{%- endif -%}
                      {{ product.featured_image | image_url }} {{ product.featured_image.width }}w
                    "
                    sizes="(min-width: 860px) 260px, 45vw"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    width="{{ product.featured_image.width }}"
                    height="{{ product.featured_image.height }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <span class="purelane-card__placeholder" role="img" aria-label="{{ 'Product image placeholder' | escape }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
                  </span>
                {%- endif -%}
              </a>
            </div>

            <h3 class="purelane-card__title" id="purelane-title-{{ section.id }}-{{ product.id }}">
              <a href="{{ product.url }}">{{ product.title | escape }}</a>
            </h3>

            <div class="purelane-card__meta">
              {%- if section.settings.show_vendor and product.vendor != blank -%}
                {{ product.vendor | escape }}
              {%- elsif product.available -%}
                <b>{{ section.settings.available_label | escape }}</b>
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </div>

            <div class="purelane-card__price">
              <strong>{{ price | money }}</strong>
              {%- if compare_at_price > price -%}
                <s>{{ compare_at_price | money }}</s>
                {%- assign discount_percent = compare_at_price | minus: price | times: 100 | divided_by: compare_at_price | round -%}
                <span class="purelane-card__saving">{{ discount_percent }}% off</span>
              {%- endif -%}
            </div>

            <product-form data-section-id="{{ section.id }}">
              {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                <input
                  type="hidden"
                  name="id"
                  value="{{ variant.id }}"
                  class="product-variant-id"
                  {% unless is_available %}
                    disabled
                  {% endunless %}
                >
                <button
                  type="submit"
                  name="add"
                  class="purelane-btn purelane-btn--small"
                  aria-labelledby="purelane-title-{{ section.id }}-{{ product.id }}"
                  aria-live="polite"
                  data-sold-out-message="true"
                  {% unless is_available %}
                    disabled
                  {% endunless %}
                >
                  <span>
                    {%- if is_available -%}
                      {{ 'products.product.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                  <span class="sold-out-message hidden">{{ 'products.product.sold_out' | t }}</span>
                  {%- render 'loading-spinner' -%}
                </button>
                <div class="product-form__error-message-wrapper purelane-card__error" role="alert" hidden>
                  <span class="product-form__error-message"></span>
                </div>
              {%- endform -%}
            </product-form>
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="purelane-glass purelane-shop__empty">
        {{ section.settings.empty_text | escape }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane product grid",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "default_badge",
      "label": "Default badge",
      "default": "Best seller"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "text",
      "id": "available_label",
      "label": "Availability label",
      "default": "In stock"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty state text",
      "default": "Choose a collection to show Purelane products."
    }
  ],
  "presets": [
    {
      "name": "Purelane product grid"
    }
  ]
}
{% endschema %}
