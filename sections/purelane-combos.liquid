{{ 'purelane.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign fallback_collection = section.settings.fallback_collection
-%}

<section class="purelane-section purelane-combos" id="combos">
  <div class="purelane-wrap">
    <div class="purelane-panel-head purelane-rv">
      {%- if section.settings.kicker != blank -%}
        <span class="purelane-kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="purelane-title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <div class="purelane-rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      {%- if section.settings.description != blank -%}
        <p class="purelane-lede">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="purelane-combos__rail purelane-rv" tabindex="0" role="list" aria-label="{{ section.settings.rail_label | escape }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign combo_title = block.settings.title | downcase
            assign combo_count = block.settings.count_label | downcase
            assign visible_slots = 3

            if combo_count contains '2 product' or combo_title contains 'hard water'
              assign visible_slots = 2
            endif

            assign combo_product_1 = blank
            assign combo_product_2 = blank
            assign combo_product_3 = blank
            assign combo_label_1 = block.settings.item_label_1
            assign combo_label_2 = block.settings.item_label_2
            assign combo_label_3 = block.settings.item_label_3

            if block.settings.product_1 != blank
              assign combo_product_1 = block.settings.product_1
              assign combo_label_1 = block.settings.item_label_1
            endif

            if block.settings.product_2 != blank
              if combo_product_1 == blank
                assign combo_product_1 = block.settings.product_2
                assign combo_label_1 = block.settings.item_label_2
              elsif combo_product_2 == blank and visible_slots > 1
                assign combo_product_2 = block.settings.product_2
                assign combo_label_2 = block.settings.item_label_2
              endif
            endif

            if block.settings.product_3 != blank
              if combo_product_1 == blank
                assign combo_product_1 = block.settings.product_3
                assign combo_label_1 = block.settings.item_label_3
              elsif combo_product_2 == blank and visible_slots > 1
                assign combo_product_2 = block.settings.product_3
                assign combo_label_2 = block.settings.item_label_3
              elsif combo_product_3 == blank and visible_slots > 2
                assign combo_product_3 = block.settings.product_3
                assign combo_label_3 = block.settings.item_label_3
              endif
            endif

            if block.settings.product_4 != blank
              if combo_product_1 == blank
                assign combo_product_1 = block.settings.product_4
                assign combo_label_1 = block.settings.item_label_4
              elsif combo_product_2 == blank and visible_slots > 1
                assign combo_product_2 = block.settings.product_4
                assign combo_label_2 = block.settings.item_label_4
              elsif combo_product_3 == blank and visible_slots > 2
                assign combo_product_3 = block.settings.product_4
                assign combo_label_3 = block.settings.item_label_4
              endif
            endif

            if block.settings.product_5 != blank
              if combo_product_1 == blank
                assign combo_product_1 = block.settings.product_5
                assign combo_label_1 = block.settings.item_label_5
              elsif combo_product_2 == blank and visible_slots > 1
                assign combo_product_2 = block.settings.product_5
                assign combo_label_2 = block.settings.item_label_5
              elsif combo_product_3 == blank and visible_slots > 2
                assign combo_product_3 = block.settings.product_5
                assign combo_label_3 = block.settings.item_label_5
              endif
            endif

            if fallback_collection != blank
              for fallback_product in fallback_collection.products
                if fallback_product.available
                  assign combo_already_selected = false

                  if combo_product_1 != blank and fallback_product.id == combo_product_1.id
                    assign combo_already_selected = true
                  endif

                  if combo_product_2 != blank and fallback_product.id == combo_product_2.id
                    assign combo_already_selected = true
                  endif

                  if combo_product_3 != blank and fallback_product.id == combo_product_3.id
                    assign combo_already_selected = true
                  endif

                  unless combo_already_selected
                    if combo_product_1 == blank
                      assign combo_product_1 = fallback_product
                    elsif combo_product_2 == blank and visible_slots > 1
                      assign combo_product_2 = fallback_product
                    elsif combo_product_3 == blank and visible_slots > 2
                      assign combo_product_3 = fallback_product
                    endif
                  endunless
                endif

                if visible_slots == 2 and combo_product_1 != blank and combo_product_2 != blank
                  break
                endif

                if visible_slots == 3 and combo_product_1 != blank and combo_product_2 != blank and combo_product_3 != blank
                  break
                endif
              endfor
            endif
          -%}
          <article class="purelane-glass purelane-combo-card{% if block.settings.featured %} purelane-combo-card--featured{% endif %}" role="listitem" {{ block.shopify_attributes }}>
            <div class="purelane-combo-card__tray">
              {%- if block.settings.savings_text != blank -%}
                <span class="purelane-combo-card__save">{{ block.settings.savings_text | escape }}</span>
              {%- endif -%}
              {%- if block.settings.flag != blank -%}
                <span class="purelane-combo-card__flag">{{ block.settings.flag | escape }}</span>
              {%- endif -%}

              <div class="purelane-combo-card__stack">
                {%- if combo_product_1 != blank or combo_label_1 != blank -%}
                  <span class="purelane-combo-card__item">
                    <span class="purelane-combo-card__image">
                      {%- if combo_product_1.featured_image -%}
                        <img src="{{ combo_product_1.featured_image | image_url: width: 260 }}" alt="{{ combo_product_1.featured_image.alt | default: combo_product_1.title | escape }}" width="{{ combo_product_1.featured_image.width }}" height="{{ combo_product_1.featured_image.height }}" loading="lazy">
                      {%- else -%}
                        <span class="purelane-mini-placeholder" role="img" aria-label="{{ 'Product placeholder' | escape }}"></span>
                      {%- endif -%}
                    </span>
                    <span class="purelane-combo-card__item-label">
                      {{ combo_label_1 | default: combo_product_1.title | escape }}
                    </span>
                  </span>
                {%- endif -%}

                {%- if visible_slots > 1 -%}
                  {%- if combo_product_2 != blank or combo_label_2 != blank -%}
                    <span class="purelane-combo-card__plus" aria-hidden="true">+</span>
                    <span class="purelane-combo-card__item">
                      <span class="purelane-combo-card__image">
                        {%- if combo_product_2.featured_image -%}
                          <img src="{{ combo_product_2.featured_image | image_url: width: 260 }}" alt="{{ combo_product_2.featured_image.alt | default: combo_product_2.title | escape }}" width="{{ combo_product_2.featured_image.width }}" height="{{ combo_product_2.featured_image.height }}" loading="lazy">
                        {%- else -%}
                          <span class="purelane-mini-placeholder" role="img" aria-label="{{ 'Product placeholder' | escape }}"></span>
                        {%- endif -%}
                      </span>
                      <span class="purelane-combo-card__item-label">
                        {{ combo_label_2 | default: combo_product_2.title | escape }}
                      </span>
                    </span>
                  {%- endif -%}
                {%- endif -%}

                {%- if visible_slots > 2 -%}
                  {%- if combo_product_3 != blank or combo_label_3 != blank -%}
                    <span class="purelane-combo-card__plus" aria-hidden="true">+</span>
                    <span class="purelane-combo-card__item">
                      <span class="purelane-combo-card__image">
                        {%- if combo_product_3.featured_image -%}
                          <img src="{{ combo_product_3.featured_image | image_url: width: 260 }}" alt="{{ combo_product_3.featured_image.alt | default: combo_product_3.title | escape }}" width="{{ combo_product_3.featured_image.width }}" height="{{ combo_product_3.featured_image.height }}" loading="lazy">
                        {%- else -%}
                          <span class="purelane-mini-placeholder" role="img" aria-label="{{ 'Product placeholder' | escape }}"></span>
                        {%- endif -%}
                      </span>
                      <span class="purelane-combo-card__item-label">
                        {{ combo_label_3 | default: combo_product_3.title | escape }}
                      </span>
                    </span>
                  {%- endif -%}
                {%- endif -%}
              </div>
            </div>

            <div class="purelane-combo-card__body">
              {%- if block.settings.title != blank -%}
                <h3 class="purelane-combo-card__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.count_label != blank -%}
                <div class="purelane-combo-card__count">{{ block.settings.count_label | escape }}</div>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="purelane-combo-card__description">{{ block.settings.description | escape }}</p>
              {%- endif -%}
              <div class="purelane-combo-card__price">
                {%- if block.settings.price_text != blank -%}
                  <strong>{{ block.settings.price_text | escape }}</strong>
                {%- endif -%}
                {%- if block.settings.compare_text != blank -%}
                  <s>{{ block.settings.compare_text | escape }}</s>
                {%- endif -%}
                {%- if block.settings.price_badge != blank -%}
                  <em>{{ block.settings.price_badge | escape }}</em>
                {%- endif -%}
              </div>
              {%- if block.settings.fine_print != blank -%}
                <div class="purelane-combo-card__fine">{{ block.settings.fine_print | escape }}</div>
              {%- endif -%}
              {%- if block.settings.cta_label != blank -%}
                <a
                  class="purelane-btn{% if block.settings.button_style == 'primary' %} purelane-btn--primary{% endif %}"
                  {% if block.settings.cta_link == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.cta_link }}"
                  {% endif %}
                >
                  {{ block.settings.cta_label | escape }}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
                </a>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="purelane-glass purelane-shop__empty">{{ 'Add combo blocks to show best-selling bundles.' }}</div>
    {%- endif -%}

    {%- if section.settings.swipe_cue != blank -%}
      <div class="purelane-swipe-cue" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
        {{ section.settings.swipe_cue | escape }}
      </div>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <p class="purelane-railnote">{{ section.settings.note | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane combos",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Swipe through the boxes people order most. Each one is already priced to make stocking up simpler."
    },
    {
      "type": "text",
      "id": "rail_label",
      "label": "Rail accessibility label",
      "default": "Best selling combos"
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Fallback product collection",
      "info": "Used to fill empty product slots in combo cards."
    },
    {
      "type": "text",
      "id": "swipe_cue",
      "label": "Swipe cue",
      "default": "Swipe for more combos"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note"
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Highlight card",
          "default": false
        },
        {
          "type": "text",
          "id": "savings_text",
          "label": "Savings label",
          "default": "You save Rs. 398"
        },
        {
          "type": "text",
          "id": "flag",
          "label": "Top flag"
        },
        {
          "type": "header",
          "content": "Products"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "text",
          "id": "item_label_1",
          "label": "Product 1 label",
          "default": "Cuts grease instantly"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "text",
          "id": "item_label_2",
          "label": "Product 2 label",
          "default": "Squeaky clean dishes"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "text",
          "id": "item_label_3",
          "label": "Product 3 label",
          "default": "Melts hard water stains"
        },
        {
          "type": "product",
          "id": "product_4",
          "label": "Product 4"
        },
        {
          "type": "text",
          "id": "item_label_4",
          "label": "Product 4 label"
        },
        {
          "type": "product",
          "id": "product_5",
          "label": "Product 5"
        },
        {
          "type": "text",
          "id": "item_label_5",
          "label": "Product 5 label"
        },
        {
          "type": "header",
          "content": "Card copy"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Kitchen essentials"
        },
        {
          "type": "text",
          "id": "count_label",
          "label": "Product count label",
          "default": "3 products"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Includes your selected products. Everything for a focused cleaning routine, without picking separately."
        },
        {
          "type": "text",
          "id": "price_text",
          "label": "Price text",
          "default": "Rs. 499"
        },
        {
          "type": "text",
          "id": "compare_text",
          "label": "Compare-at text",
          "default": "Rs. 897"
        },
        {
          "type": "text",
          "id": "price_badge",
          "label": "Price badge",
          "default": "Save Rs. 398"
        },
        {
          "type": "text",
          "id": "fine_print",
          "label": "Fine print",
          "default": "Inclusive of all taxes. COD available"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label",
          "default": "Shop bundle"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "CTA link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            {
              "value": "ghost",
              "label": "Glass"
            },
            {
              "value": "primary",
              "label": "Primary"
            }
          ],
          "default": "ghost"
        }
